    \u0432\u0435\u0440\u0441\u0442\u0430\u043A\u043E\u0432 \u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E
    \u043E\u0440\u0443\u0436\u0438\u044F. \u0413\u043E\u0434\u0438\u0442\u0441\u044F
    \u0438 \u043A\u0430\u043A \u0442\u043E\u043F\u043B\u0438\u0432\u043E \u0434\u043B\u044F
