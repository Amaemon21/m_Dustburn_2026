<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <NoWarn>CS0414;CS0169;CS0649;CS0660;CS0661;CS0108;CS0067;CS8981</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>Harness</StartupObject>
    <WorldGeneration>../../Assets/_Dustborn/Scripts/Gameplay/Service/WorldService</WorldGeneration>
    <SharedUtils>../../Assets/_Dustborn/Scripts/Utils</SharedUtils>
    <Mathematics>../../Library/PackageCache/com.unity.mathematics@*/Unity.Mathematics</Mathematics>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="JobStubs.cs" />
    <Compile Include="AssetReader.cs" />
    <Compile Include="Missing.cs" />
    <Compile Include="Png.cs" />
    <Compile Include="Draw.cs" />
    <Compile Include="Harness.cs" />
    <Compile Include="WorldMapPipelineChecks.cs" />
    <Compile Include="GeneratedAssetFileChecks.cs" />
    <Compile Include="GroundAppearanceChecks.cs" />
    <Compile Include="SplatChecks.cs" />
    <Compile Include="VoxelSeamChecks.cs" />
    <Compile Include="WorldFeatureChecks.cs" />
    <Compile Include="WaterChecks.cs" />
    <Compile Include="WaterAudit.cs" />
    <Compile Include="BakeParity.cs" />
    <Compile Include="MonoRewrite.cs" />
    <Compile Include="WaterView.cs" />
    <Compile Include="WaterShoreChecks.cs" />
    <Compile Include="NoiseParityChecks.cs" />
    <Compile Include="WaterFixtures.cs" />
    <Compile Include="QualityChecks.cs" />
    <Compile Include="WaterStampLoader.cs" />
    <Compile Include="WaterStampChecks.cs" />
    <Compile Include="WaterStampReport.cs" />
    <Compile Include="WaterStampWorlds.cs" />
    <Compile Include="GroundPreview.cs" />
    <Compile Include="RoadPaintChecks.cs" />
    <Compile Include="RoadTopologyChecks.cs" />
    <Compile Include="RoadAudit.cs" />
    <Compile Include="WaterPolicyAudit.cs" />
    <Compile Include="RiverTopologyAudit.cs" />
    <Compile Include="RiverShapeAudit.cs" />
    <Compile Include="$(WorldGeneration)/Editor/GeneratedAssetFile.cs" />
    <Compile Include="$(Mathematics)/**/*.cs" Exclude="$(Mathematics)/math_unity_conversion.cs;$(Mathematics)/PropertyAttributes.cs" />
    <Compile Include="$(SharedUtils)/**/*.cs" Exclude="$(SharedUtils)/UIWear/**/*.cs" />
    <Compile Include="$(WorldGeneration)/**/*.cs"
             Exclude="$(WorldGeneration)/Editor/**/*.cs;
                      $(WorldGeneration)/Runtime/WorldGenerator.cs;
                      $(WorldGeneration)/Runtime/WorldRuntimeLoader.cs;
                      $(WorldGeneration)/Data/World/BakedWorld.cs;
                      $(WorldGeneration)/Generation/Buildings/PoiInstanceBuilder.cs;
                      $(WorldGeneration)/Voxel/Streaming/VoxelTerrainBuilder*.cs;
                      $(WorldGeneration)/Voxel/Streaming/VoxelTerrainStreamer*.cs;
                      $(WorldGeneration)/Voxel/Decor/VoxelDecorSpawner.cs;
                      $(WorldGeneration)/Voxel/Decor/MeshCombiner.cs;
                      $(WorldGeneration)/Voxel/Decor/VoxelDecorRenderer.cs;
                      $(WorldGeneration)/Voxel/Decor/GrassCardFactory.cs;
                      $(WorldGeneration)/Voxel/Streaming/VoxelColliderQueue.cs;
                      $(WorldGeneration)/Voxel/Decor/VoxelDecorBuild.cs;
                      $(WorldGeneration)/Voxel/Material/RepetitionlessVoxelSetup.cs;
                      $(WorldGeneration)/Voxel/Material/VoxelGroundMaterial.cs;
                      $(WorldGeneration)/Voxel/Scene/VoxelColumnDebug.cs;
                      $(WorldGeneration)/Voxel/Scene/WaterSurfaceBuilder.cs;
                      $(WorldGeneration)/Voxel/Scene/WaterCrossingBuilder.cs;
                      $(WorldGeneration)/Voxel/Scene/WorldEdgeBuilder.cs;
                      $(WorldGeneration)/Voxel/Scene/WorldFeatureGizmos.cs;
                      $(WorldGeneration)/Generation/Biomes/BiomeMapTexture.cs;
                      $(WorldGeneration)/Generation/Relief/HeightMapTexture.cs" />
  </ItemGroup>
</Project>
