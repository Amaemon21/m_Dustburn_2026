<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>CatalogDump</AssemblyName>
    <StartupObject>CatalogDump</StartupObject>
    <Benchmarks>$(MSBuildThisFileDirectory)..\..\..\Assets\_Dustborn\Benchmarks\WorldGeneration</Benchmarks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(Benchmarks)\WorldGenBenchCatalog.cs" />
  </ItemGroup>
</Project>
